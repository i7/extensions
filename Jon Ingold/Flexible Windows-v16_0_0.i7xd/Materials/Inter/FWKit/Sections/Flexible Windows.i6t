Flexible Windows.

Implementation functions for the Flexible Windows extension.

@h Definitions and globals.
A few definitions and globals needed by our functions.

=
Constant FW_style_All = -1;
Constant GLK_COLOUR_UNSET = $4A4123;

Global active_window = Main_Window;
Global current_focus_window = Main_Window;

@h Constructing a window.
Handles the actual construction of a window.

=
[ FW_CONSTRUCT_WINDOW_R win parentwin method size;
	win = parameter_value;
	! Fill in parentwin, method and size if needed
	if (glk_window_get_root() ~= nothing) {
		parentwin = GProperty(OBJECT_TY, win, window_spawner).glk_ref;
		if (win.split_method == winmethod_inherited_placement) {
			IssueRTP("InvalidWindowSplitMethod", "FW_CONSTRUCT_WINDOW_R: invalid split method.", FWKitRTPs);
			rfalse;
		}
		method = win.split_method | win.split_dir;
		if (~~win.split_border) {
			method = method | winmethod_NoBorder;
		}
		size = win.split_size;
	}
	win.glk_ref = FW_glk_window_open(parentwin, method, size, win.glk_window_type, win.glk_rock);
	rfalse;
];

[ FW_glk_window_open _vararg_count ret;
	! glk_window_open(window, uint, uint, uint, uint) => window
	@glk 35 _vararg_count ret;
	return ret;
];

@h Deconstructing a window.
Deconstructing a window is much simpler however.

=
[ FW_DECONSTRUCT_WINDOW_R win;
	win = parameter_value;
	FW_glk_window_close(win.glk_ref, 0);
	win.glk_ref = 0;
	rfalse;
];

[ FW_glk_window_close _vararg_count;
	! glk_window_close(window, &{uint, uint})
	@glk 36 _vararg_count 0;
	return 0;
];

@h Focus a window.
We have to augment the basic window focus function to remember the window.

=
+replacing(from Architecture32Kit) [ WindowFocus win;
	if (win) {
		if (win.glk_ref) {
			glk_set_window(win.glk_ref);
			current_focus_window = win;
		}
		else {
			IssueRTP("WindowIsClosed", "WindowFocus: Cannot perform this Glk window operation on a closed window.", Architecture32KitRTPs);
		}
	}
	else {
		IssueRTP("WindowIsNothing", "WindowFocus: Cannot perform this Glk window operation on nothing.", Architecture32KitRTPs);
	}
];

@h Clearing a window.
Augment the |WindowClear| function to handle background colours.

=
+replacing(from Architecture32Kit) [ WindowClear win;
	if (win && win.glk_ref) {
		if (win.background_colour ~= GLK_COLOUR_UNSET && win.glk_window_type == wintype_Graphics) {
			glk_window_set_background_color(win.glk_ref, win.background_colour);
		}
		glk_window_clear(win.glk_ref);
	}
];

@h Background colours.
Apply a textual window's background colour.

=
[ FW_Apply_Background_Colour win wintype col i;
	wintype = win.glk_window_type;
	col = win.background_colour;
	for (i = 0: i < style_NUMSTYLES : i++) {
		glk_stylehint_set(wintype, i, stylehint_BackColor, col);
	}
];

[ FW_Unapply_Background_Colour win wintype i;
	wintype = win.glk_window_type;
	for (i = 0: i < style_NUMSTYLES : i++) {
		glk_stylehint_clear(wintype, i, stylehint_BackColor);
	}
];

@h Glulx Text Effects.
Unapplying stylehints.

=
[ FW_Unapply_Stylehint wintype stylenum hint i;
	if (stylenum == FW_style_All) {
		for (i = 0: i < style_NUMSTYLES : i++) {
			glk_stylehint_clear(wintype, i, hint);
		}
	}
	else {
		glk_stylehint_clear(wintype, stylenum, hint);
	}
];

@h The page margin.
We try to detect the default page margin colour.

=
Global default_page_margin_colour = GLK_COLOUR_UNSET;

[ FW_DETECT_PAGE_MARGIN_COLOUR_R res win;
	! Open the window manually to skip the FW process - for example we don't want to apply styles!
	win = FW_glk_window_open(0, 0, 0, wintype_TextBuffer, 0);
	res = glk_style_measure(win, style_Normal, stylehint_BackColor, gg_arguments);
	if (res) {
		default_page_margin_colour = gg_arguments-->0;
	}
	FW_glk_window_close(win, 0);
	rfalse;
];

[ FW_Set_Default_Page_Margin_Colour;
	if (default_page_margin_colour == GLK_COLOUR_UNSET) {
		glk_stylehint_clear(wintype_TextBuffer, style_Normal, stylehint_BackColor);
	}
	else {
		glk_stylehint_set(wintype_TextBuffer, style_Normal, stylehint_BackColor, default_page_margin_colour);
	}
];

@h Interjecting for unscheduled constructions.
We no longer allow windows to be constructed via I6.

